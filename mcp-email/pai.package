[package]
name        = mcp-email
version     = 1.1.1
type        = mcp
description = Email connector: read and manage mail via IMAP (including listing and downloading attachments) plus send via SMTP in one MCP server. Credentials via MAIL_* environment variables (MakerCLI connector-ready). Works with Gmail app passwords, Outlook, Zoho and any standard IMAP/SMTP provider.
author      = PascalAI
license     = MIT
tags        = email,imap,smtp,mail,gmail,outlook,zoho,attachments,connector,agent

[mcp]
runtime          = binary
entrypoint       = bin/win64/mcp-email.exe
entrypoint_lin64 = bin/linux64/mcp-email
